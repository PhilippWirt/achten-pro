<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Playfight — structured physical play, self-regulation and real contact.">
  <title>achten.pro — Playfight</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #050b12;
      --surface: #0b111e;
      --surface2: #10182c;
      --text: #e8f2ff;
      --muted: #94a9c6;
      --primary: #3ecabb;
      --secondary: #4cb4e8;
      --accent: #d3af37;
      --border: rgba(209, 175, 55, 0.16);
      --radius: 24px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Manrope", Arial, sans-serif;
      background:
        radial-gradient(circle at 5% 5%, rgba(62,202,187,.12), transparent 28%),
        radial-gradient(circle at 96% 10%, rgba(76,180,232,.10), transparent 26%),
        linear-gradient(180deg, #061018 0%, var(--bg) 60%, #050d18 100%);
      color: var(--text);
      line-height: 1.65;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      display: block;
      max-width: 100%;
    }

    .container {
      width: min(1120px, calc(100% - 32px));
      margin: 0 auto;
    }

    .header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(5, 11, 18, .84);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(255,255,255,.07);
    }

    .nav {
      min-height: 68px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .brand {
      display: flex;
      flex-direction: column;
      line-height: 1.1;
    }

    .brand strong {
      font-size: 15px;
    }

    .brand span {
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .12em;
      margin-top: 5px;
    }

    .nav-links {
      display: flex;
      gap: 22px;
      color: var(--muted);
      font-size: 13px;
      font-weight: 700;
    }

    .nav-links a:hover {
      color: var(--primary);
    }

    .button {
      min-height: 48px;
      padding: 0 22px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 800;
      transition: transform .2s ease, opacity .2s ease;
    }

    .button:hover {
      transform: translateY(-2px);
      opacity: .92;
    }

    .button-primary {
      color: #fff;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      box-shadow: 0 10px 30px rgba(62,202,187,.24);
    }

    .button-outline {
      color: var(--text);
      background: rgba(255,255,255,.07);
      border: 1px solid rgba(255,255,255,.22);
    }

    .hero {
      padding: 28px 0 72px;
    }

    .hero-shell {
      min-height: 660px;
      display: flex;
      align-items: flex-end;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 36px;
      overflow: hidden;
      box-shadow: 0 28px 80px rgba(0,0,0,.55);
      background:
        linear-gradient(90deg, rgba(4,10,18,.92) 0%, rgba(4,10,18,.68) 52%, rgba(4,10,18,.25) 100%),
        url("assets/images/playfight-hero-zelt.jpg") center/cover no-repeat,
        #071019;
    }

    .hero-content {
      max-width: 820px;
      padding: 54px 36px;
    }

    .eyebrow {
      display: inline-flex;
      padding: 7px 13px;
      margin-bottom: 22px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.16);
      background: rgba(255,255,255,.07);
      color: #c8e9ff;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .12em;
    }

    h1, h2 {
      font-family: "Instrument Serif", Georgia, serif;
      font-weight: 400;
      letter-spacing: -.04em;
      line-height: .92;
    }

    h1 {
      max-width: 10ch;
      font-size: clamp(58px, 10vw, 108px);
    }

    h1 em {
      color: #b7f1e7;
    }

    h2 {
      margin-bottom: 16px;
      font-size: clamp(42px, 6vw, 70px);
    }

    .hero p {
      max-width: 640px;
      margin: 24px 0 28px;
      color: rgba(255,255,255,.84);
      font-size: clamp(16px, 2vw, 20px);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    section {
      padding: 72px 0;
    }

    .contrast {
      border-block: 1px solid var(--border);
      background:
        radial-gradient(circle at 90% 8%, rgba(76,180,232,.12), transparent 30%),
        linear-gradient(180deg, rgba(209,175,55,.08), rgba(209,175,55,.025));
    }

    .kicker {
      display: block;
      margin-bottom: 13px;
      color: var(--accent);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .15em;
    }

    .section-intro {
      max-width: 700px;
      margin-bottom: 34px;
      color: var(--muted);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .card {
      padding: 28px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: rgba(16,24,44,.88);
      box-shadow: 0 12px 30px rgba(0,0,0,.18);
    }

    .card h3 {
      margin-bottom: 12px;
      font-size: 21px;
      line-height: 1.25;
    }

    .card p {
      color: var(--muted);
      font-size: 15px;
    }

    .guide-card {
      border-color: rgba(211,175,55,.42);
      background:
        radial-gradient(circle at 100% 0%, rgba(211,175,55,.14), transparent 45%),
        rgba(16,24,44,.93);
    }

    .guide-features {
      display: grid;
      gap: 9px;
      margin: 18px 0 5px;
      list-style: none;
      color: var(--muted);
      font-size: 14px;
    }

    .guide-features li::before {
      content: "✓";
      margin-right: 9px;
      color: var(--primary);
      font-weight: 800;
    }

    .price {
      margin-top: 14px;
      color: var(--accent) !important;
      font-size: 13px !important;
      font-weight: 800;
    }

    .why-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    ul {
      padding-left: 20px;
      margin-top: 16px;
      color: var(--muted);
    }

    li + li {
      margin-top: 7px;
    }

    .credentials {
      display: grid;
      gap: 10px;
      margin-top: 24px;
    }

    .credential {
      padding: 10px 15px;
      border: 1px solid rgba(209,175,55,.18);
      border-radius: 12px;
      background: rgba(209,175,55,.08);
      color: #e8d78e;
      font-size: 13px;
      font-weight: 700;
    }

    .workshop-image {
      width: 100%;
      max-height: 440px;
      margin-top: 24px;
      object-fit: cover;
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .contact {
      padding: 36px;
      border: 1px solid var(--border);
      border-radius: 32px;
      background:
        linear-gradient(140deg, rgba(209,175,55,.09), rgba(62,202,187,.08), rgba(16,24,44,.96));
      box-shadow: 0 24px 70px rgba(0,0,0,.28);
    }

    form {
      display: grid;
      max-width: 620px;
      gap: 14px;
      margin-top: 24px;
    }

    label {
      font-size: 13px;
      font-weight: 700;
    }

    input, textarea {
      display: block;
      width: 100%;
      min-height: 48px;
      margin-top: 7px;
      padding: 12px 14px;
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 13px;
      outline: none;
      background: rgba(5,11,18,.68);
      color: var(--text);
      font: inherit;
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    button {
      border: 0;
      cursor: pointer;
    }

    .footer {
      padding: 34px 0;
      border-top: 1px solid rgba(255,255,255,.08);
      color: var(--muted);
      font-size: 13px;
    }

    .footer-inner {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 18px;
    }

    @media (max-width: 760px) {
      .nav-links {
        display: none;
      }

      .nav .button {
        min-height: 42px;
        padding: 0 15px;
        font-size: 12px;
      }

      .hero-shell {
        min-height: 600px;
        border-radius: 25px;
        background:
          linear-gradient(0deg, rgba(4,10,18,.94) 0%, rgba(4,10,18,.46) 100%),
          url("assets/images/playfight-hero-zelt.jpg") center/cover no-repeat,
          #071019;
      }

      .hero-content {
        padding: 32px 22px;
      }

      .grid,
      .why-grid {
        grid-template-columns: 1fr;
      }

      section {
        padding: 55px 0;
      }

      .contact {
        padding: 25px 20px;
      }
    }
  </style>
</head>

<body>
  <header class="header">
    <div class="container nav">
      <a class="brand" href="#top">
        <strong>achten.pro</strong>
        <span>Playfight · Touch with backbone</span>
      </a>

      <nav class="nav-links" aria-label="Main navigation">
        <a href="#guide">Guide</a>
        <a href="#why">Why Playfight</a>
        <a href="#experience">Experience</a>
        <a href="#contact">Contact</a>
      </nav>

      <a class="button button-primary" href="#guide">Explore guide</a>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="container">
        <div class="hero-shell">
          <div class="hero-content">
            <span class="eyebrow">Playfight · Contact at eye level</span>

            <h1>
              Real contact.<br>
              <em>Real play.</em>
            </h1>

            <p>
              Structured physical play for friends and adults:
              less performance pressure, more presence, boundaries,
              regulation and genuine connection.
            </p>

            <div class="hero-actions">
              <a class="button button-primary" href="#guide">
                Get the Playfight Guide
              </a>

              <a class="button button-outline" href="#why">
                How it works
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="guide" class="contrast">
      <div class="container">
        <span class="kicker">Available now</span>

        <h2>
          Your entry into<br>
          real contact.
        </h2>

        <p class="section-intro">
          A practical video guide for structured physical play with friends.
          Clear, safe and immediately usable at home.
        </p>

        <div class="grid">
          <article class="card">
            <h3>Playfight Updates + Exercises</h3>

            <p>
              Receive event notes, simple exercises and occasional updates
              about new Playfight formats.
            </p>

            <p class="price">
              No spam. No pressure. Only useful content.
            </p>
          </article>

          <article class="card guide-card">
            <h3>Playfight Guide — Friends &amp; Adults</h3>

            <p>
              An English video guide for adults who want to explore
              structured physical play with friends — without performance
              pressure and without unnecessary risk. Start immediately
              after purchase.
            </p>

            <ul class="guide-features">
              <li>30-minute video guide</li>
              <li>60+ minutes of practical exercises</li>
              <li>5 core partner exercises</li>
              <li>Clear progression ladder</li>
              <li>Suitable for friends and adults</li>
            </ul>

            <a
              class="button button-primary"
              href="https://philwirt.gumroad.com/l/playfight-friends"
              target="_blank"
              rel="noopener noreferrer"
              style="margin-top:22px"
            >
              Buy the guide – €19
            </a>

            <p class="price">Available now · €19</p>
          </article>
        </div>
      </div>
    </section>

    <section id="why">
      <div class="container">
        <span class="kicker">Why &amp; how</span>

        <h2>
          Strength without<br>
          performance pressure.
        </h2>

        <div class="why-grid">
          <article class="card">
            <h3>Why Playfight works</h3>

            <p>
              Real strength arises where contact is possible. Not as
              competition. Not as proof of performance. But as encounter.
              You do not train against someone — you train with someone.
            </p>

            <ul>
              <li>Touch with backbone</li>
              <li>Community instead of performance pressure</li>
              <li>Precision instead of randomness</li>
              <li>Boundaries you can feel and communicate</li>
            </ul>
          </article>

          <article class="card">
            <h3>Structure creates safety</h3>

            <p>
              Playfight is not freestyle fighting. Clear restrictions and
              simple signals create a space where exploration can happen
              without overload.
            </p>

            <ul>
              <li>A restriction ladder instead of open dynamics</li>
              <li>Four clear signals instead of complexity</li>
              <li>5–5 breathing as an anchor</li>
              <li>Body first, talk second</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section id="experience" class="contrast">
      <div class="container">
        <span class="kicker">Experience</span>

        <h2>Science you can feel.</h2>

        <p class="section-intro">
          Physically and nervous-system effective — without empty concepts.
          Playfight combines movement, self-regulation, connection and
          practical structure.
        </p>

        <div class="credentials">
          <div class="credential">
            M.Sc. Sport Psychology — Performance, Regulation, Coaching
          </div>

          <div class="credential">
            B.Sc. Sports Science — Training, Movement, Nervous System
          </div>

          <div class="credential">
            Self-regulation and biofeedback trainer
          </div>

          <div class="credential">
            Breath, bodywork and Playfight application
          </div>

          <div class="credential">
            Developer of the achten.pro Playfight approach
          </div>
        </div>

        <img
          class="workshop-image"
          src="assets/images/playfight-workshop-zelt.jpg"
          alt="Playfight workshop in a tent"
        >
      </div>
    </section>

    <section id="contact">
      <div class="container">
        <div class="contact">
          <span class="kicker">Contact</span>

          <h2>Interested in Playfight?</h2>

          <p class="section-intro">
            Tell me briefly what you are looking for. I will get back to you
            personally with a suitable proposal.
          </p>

          <form action="https://formspree.io/f/mwvzgwrb" method="POST">
            <input
              type="hidden"
              name="_subject"
              value="New inquiry via achten.pro Playfight"
            >

            <label>
              First name
              <input
                type="text"
                name="first_name"
                placeholder="Your first name"
              >
            </label>

            <label>
              Email
              <input
                type="email"
                name="email"
                placeholder="you@example.com"
                required
              >
            </label>

            <label>
              Your message
              <textarea
                name="message"
                placeholder="What are you looking for?"
              ></textarea>
            </label>

            <button class="button button-primary" type="submit">
              Send inquiry
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <p>achten.pro · Playfight · Munich · 2026</p>

      <p>
        Philipp Wiertelorz ·
        <a href="mailto:philwirt@web.de">philwirt@web.de</a>
      </p>
    </div>
  </footer>
</body>
</html>
